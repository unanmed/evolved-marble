{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* TS 7 no longer infers rootDir. This base config covers both `src` and
           `tests` with noEmit, so rootDir must span the repo root. */
        "rootDir": ".",

        /* Linting */
        "strict": true,

        /* TS 7 removed baseUrl (TS5102): paths must be relative to this config */
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "tests"]
}
