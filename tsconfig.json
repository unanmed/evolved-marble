{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* TS 7 no longer infers rootDir (Pitfall 7).
           This base project includes both `src` and `tests` (noEmit), so rootDir
           must span the repo root; tsconfig.sim.json narrows it to `src` itself. */
        "rootDir": ".",

        /* Linting */
        "strict": true,

        /* TS 7 removed baseUrl (TS5102): paths must be relative to this config */
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "tests"]
}
