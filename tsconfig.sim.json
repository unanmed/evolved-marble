{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        /* DOM-free: 任何 DOM 全局在此工程内都是类型错误（SIM-03 / D-03） */
        "lib": ["ESNext"],
        /* 不引入 @types/node —— 模拟核心不得触碰 Node/DOM */
        "types": [],
        "rootDir": "src"
    },
    "include": ["src/sim/**/*.ts", "src/config/**/*.ts"]
}
